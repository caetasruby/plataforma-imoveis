@startuml casos_de_uso
' Diagrama de casos de uso actualizado na Fase III (18 casos de uso)
left to right direction
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam usecase {
  BackgroundColor #FFFFFF
  BorderColor #0F4C5C
  ArrowColor #1D2A2E
}
skinparam actorBorderColor #1D2A2E
skinparam actorBackgroundColor #FFFFFF
skinparam rectangle {
  BorderColor #1D2A2E
  FontSize 15
}
skinparam packageStyle rectangle

actor "Utilizador" as U
actor "Proprietário/\nAgência" as P
actor "Inquilino/\nComprador" as I
actor "Administrador" as A
P -up-|> U
I -up-|> U
A -up-|> U

rectangle "Casa Certa: Plataforma Inteligente de Imóveis" {
  usecase "UC14 Registar conta" as UC14
  usecase "UC15 Iniciar e terminar\nsessão" as UC15
  usecase "UC17 Gerir perfil\npessoal" as UC17

  usecase "UC01 Publicar anúncio" as UC01
  usecase "UC02 Editar anúncio" as UC02
  usecase "UC03 Remover anúncio" as UC03

  usecase "UC04 Pesquisar imóveis" as UC04
  usecase "UC05 Visualizar preço\njusto" as UC05
  usecase "UC06 Visualizar alertas\nde fraude" as UC06
  usecase "UC07 Visualizar mapa\ninteractivo" as UC07
  usecase "UC18 Guardar imóveis\nfavoritos" as UC18
  usecase "UC08 Receber\nrecomendações" as UC08
  usecase "UC09 Obter esclarecimentos\n(assistente virtual)" as UC09
  usecase "Consultar procedimentos\ne documentação" as PROC

  usecase "UC10 Moderar anúncios" as UC10
  usecase "UC11 Gerir utilizadores" as UC11
  usecase "UC12 Acompanhar alertas" as UC12
  usecase "UC13 Visualizar\nindicadores" as UC13
  usecase "UC16 Gerir parâmetros\ndo sistema" as UC16
}

U --> UC14
U --> UC15
U --> UC17

P --> UC01
P --> UC02
P --> UC03

I --> UC04
I --> UC08
I --> UC09
UC04 ..> UC05 : <<include>>
UC04 ..> UC06 : <<include>>
UC04 ..> UC07 : <<include>>
UC18 .up.> UC04 : <<extend>>
PROC .up.> UC09 : <<extend>>

A --> UC10
A --> UC11
A --> UC12
A --> UC13
A --> UC16
@enduml
